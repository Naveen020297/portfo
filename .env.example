# Which site renders: "studio" (light lineup page, default) or "space" (the original 3D fly-through).
NEXT_PUBLIC_SITE_THEME="studio"

# Show direct contact channels (email, phone, WhatsApp) at the bottom / footer.
# Set to "true" to display them, defaults to hidden ("false").
NEXT_PUBLIC_SHOW_DIRECT_CONTACT="false"

# PostgreSQL connection string (Neon). Once set, project requests from the contact form are stored
# in the contact_requests table; until then they only reach the server log.
# After setting it, create the tables with: npm run db:migrate
DATABASE_URL=

# Optional: Datadog RUM. Telemetry stays off until both are set.
NEXT_PUBLIC_DD_APP_ID=
NEXT_PUBLIC_DD_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_DD_ENV=production
